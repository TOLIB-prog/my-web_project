{
	"editor.formatOnSave": true,
	"editor.fontSize": 18,
	"editor.mouseWheelZoom": true,
	"css.format.braceStyle": "collapse",
	"css.format.newlineBetweenRules": true,
	"css.format.newlineBetweenSelectors": true,
	"css.format.preserveNewLines": true,
	"css.format.spaceAroundSelectorSeparator": false,
	"css.format.maxPreserveNewLines": 80,
	"css.hover.documentation": false,
	"css.hover.references": true,
	"css.completion.triggerPropertyValueCompletion": false,
	"css.completion.completePropertyWithSemicolon": false,
	"editor.defaultFormatter": null,
	"editor.tabSize": 3,
	"scss.format.maxPreserveNewLines": 80,
	"javascript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyParenthesis": true,
	"[css]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"editor.wrapOnEscapedLineFeeds": true,
	"notebook.output.wordWrap": true,
	"html.format.wrapAttributes": "preserve",
	"editor.formatOnType": true,
	"editor.smoothScrolling": true,
	"editor.scrollbar.vertical": "hidden"
}
