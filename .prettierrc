{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "printWidth": 120,
  "htmlWhitespaceSensitivity": "css",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "auto",
  "proseWrap": "preserve",

  "overrides": [
    {
      "files": ["*.css", "*.scss", "*.less"],
      "options": {
        "cssEmptyLines": "never"
      }
    }
  ]
}
